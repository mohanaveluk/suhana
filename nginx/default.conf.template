# Aurora Matrimony web — nginx template (rendered by the nginx image's envsubst at container start).
# Only the variables below are substituted; nginx's own $variables are left alone.
#   CANONICAL_HOST  preferred host, e.g. www.auroramatrimony.com
#   APEX_HOST       bare domain to 301 to the canonical host, e.g. auroramatrimony.com
#   API_ORIGIN      API origin for the live blog sitemap, e.g. https://api.auroramatrimony.com
#   INDEXNOW_KEY    same key as the API's INDEXNOW_KEY (served at /<key>.txt for verification)

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Relative Location headers: TLS is terminated before nginx (Cloud Run), so absolute
    # redirects would otherwise point at http://.
    absolute_redirect off;
    port_in_redirect off;

    # ── One canonical host ─────────────────────────────────────────────────
    if ($host = "${APEX_HOST}") {
        return 301 https://${CANONICAL_HOST}$request_uri;
    }

    # ── No trailing slashes (except the root) ──────────────────────────────
    rewrite ^/(.+)/$ /$1 permanent;

    # ── Permanent redirects for duplicate / renamed URLs ────────────────────
    location = /privacy          { return 301 /privacy-policy; }
    location = /terms            { return 301 /terms-of-service; }
    location = /about-us         { return 301 /about; }
    location = /contact-us       { return 301 /contact; }
    location = /membership-plans { return 301 /premium; }

    # ── SEO files ──────────────────────────────────────────────────────────
    location = /robots.txt         { add_header Cache-Control "public, max-age=3600"; try_files $uri =404; }
    location = /sitemap.xml        { add_header Cache-Control "public, max-age=3600"; try_files $uri =404; }
    location = /sitemap-pages.xml  { add_header Cache-Control "public, max-age=3600"; try_files $uri =404; }

    # Live blog sitemap, generated by the API from published articles.
    location = /sitemap-blog.xml {
        proxy_pass ${API_ORIGIN}/api/v1/seo/sitemap-blog.xml;
        proxy_ssl_server_name on;
        proxy_set_header Accept "application/xml";
    }

    # IndexNow key verification file.
    location = /${INDEXNOW_KEY}.txt {
        default_type text/plain;
        return 200 "${INDEXNOW_KEY}";
    }

    # ── Static assets ──────────────────────────────────────────────────────
    # Hashed build output (main-XXXX.js, chunk-XXXX.js, styles-XXXX.css) never changes.
    location ~* ^/[^/]+-[A-Z0-9]{8,}\.(js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    # Images, fonts and other public assets keep their names across deploys: cache, but revalidate.
    location ~* \.(png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # ── Pages ──────────────────────────────────────────────────────────────
    # Blog articles: prerendered HTML when available, otherwise the indexable client shell
    # (articles published after the last build).
    location /matrimony-blog/ {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/index.html /blog.csr.html;
    }

    # Prerendered public pages are served as real HTML (route/index.html). Everything else is the
    # client-rendered app shell (index.csr.html), which is noindex from the first byte.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/index.html /index.csr.html;
    }

    gzip on;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml
        application/xml+rss
        application/ld+json
        image/svg+xml
        text/javascript;
}
